# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database Configuration
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/brightloop_db
PGHOST=localhost
PGUSER=postgres
PGPASSWORD=YOUR_PASSWORD_HERE
PGDATABASE=brightloop_db
PGPORT=5432

# Test Database URL (Used for automated integration testing)
TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/brightloop_test_db

# Security & JWT Tokens
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email / Notification Service (Optional)
EMAIL_SERVICE_ENABLED=true
EMAIL_FROM="BrightLoop Cloud" <noreply@brightloop.io>
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_SECURE=false
